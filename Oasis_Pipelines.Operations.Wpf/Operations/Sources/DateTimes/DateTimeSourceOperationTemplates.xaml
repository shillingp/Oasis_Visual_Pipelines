<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:dateTimes="clr-namespace:Oasis_Pipelines.Operations.Sources.DateTimes;assembly=Oasis_Pipelines.Operations"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type dateTimes:DateSourceOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <material:Card
                Margin="5"
                Padding="2"
                VerticalAlignment="Center">
                <DatePicker SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}" />
            </material:Card>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>