<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:strings="clr-namespace:Oasis_Pipelines.Operations.Sources.Strings;assembly=Oasis_Pipelines.Operations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type strings:StringSourceOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <material:Card Margin="5" VerticalAlignment="Center">
                <TextBox
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    Margin="5"
                    Padding="2"
                    Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center" />
            </material:Card>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>