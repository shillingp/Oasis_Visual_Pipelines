<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:Oasis_Pipelines.Controls;assembly=Oasis_Pipelines.Controls"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:numbers="clr-namespace:Oasis_Pipelines.Operations.Sources.Numbers;assembly=Oasis_Pipelines.Operations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type numbers:NumberSourceOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <material:Card Margin="5" VerticalAlignment="Center">
                <controls:NumericUpDownControl NumberValue="{Binding NumberValue, Mode=TwoWay}" />
            </material:Card>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>