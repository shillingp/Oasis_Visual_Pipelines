<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:dataTables="clr-namespace:Oasis_Pipelines.Operations.Sources.DataTables;assembly=Oasis_Pipelines.Operations"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type dataTables:DataTableSourceOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <DockPanel>
                <material:Card
                    DockPanel.Dock="Right"
                    Margin="0,5,5,5"
                    Width="30">
                    <Button
                        Command="{Binding EditResultTableDataManuallyCommand}"
                        Content="{material:PackIcon Kind=Edit}"
                        Style="{StaticResource MaterialDesignToolButton}" />
                </material:Card>
                <material:Card Margin="5" VerticalAlignment="Stretch">
                    <material:PackIcon
                        HorizontalAlignment="Center"
                        Kind="Table"
                        Margin="7"
                        Padding="2"
                        VerticalAlignment="Center" />
                </material:Card>
            </DockPanel>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dataTables:ExcelDataTableSourceOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <Button
                Command="{Binding UpdateExcelSourceCommand}"
                Content="Update Source"
                Margin="15,5"
                Padding="0" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dataTables:SQLDataTableSourceOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <Button
                Command="{Binding UpdateConnectionSettingsCommand}"
                Content="Update Settings"
                Margin="15,5"
                Padding="0" />
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>