<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:strings="clr-namespace:Oasis_Pipelines.Operations.Operations.Aggregations.Strings;assembly=Oasis_Pipelines.Operations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type strings:CombineStringOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <UniformGrid Columns="5" VerticalAlignment="Center">
                <material:PackIcon HorizontalAlignment="Center" Kind="FormatQuoteClose" />
                <material:PackIcon HorizontalAlignment="Center" Kind="ArrowRight" />
                <material:PackIcon HorizontalAlignment="Center" Kind="And" />
                <material:PackIcon HorizontalAlignment="Center" Kind="ArrowRight" />
                <material:PackIcon HorizontalAlignment="Center" Kind="FormatQuoteClose" />
            </UniformGrid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>