<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:dataTables="clr-namespace:Oasis_Pipelines.Operations.Transforms.DataTables;assembly=Oasis_Pipelines"
    xmlns:local="clr-namespace:Oasis_Pipelines.Operations.Transforms.DataTables;assembly=Oasis_Pipelines.Operations"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type local:InsertColumnOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <material:Card Margin="5" VerticalAlignment="Center">
                <TextBox
                    Margin="5"
                    Text="{Binding ColumnName, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center" />
            </material:Card>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:RenameColumnOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <material:Card>
                <UniformGrid Margin="5" Rows="2">
                    <ComboBox
                        ItemsSource="{Binding ValidColumns}"
                        MinHeight="24"
                        SelectedItem="{Binding SelectedColumn}" />
                    <TextBox Text="{Binding NewColumnName}" />
                </UniformGrid>
            </material:Card>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:UpdateColumnOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <material:Card>
                <ComboBox
                    ItemsSource="{Binding ValidColumns}"
                    Margin="5"
                    SelectedItem="{Binding ColumnName}"
                    VerticalAlignment="Center" />
            </material:Card>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>