<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:dataTables="clr-namespace:Oasis_Pipelines.Operations.Operations.Joins.DataTables;assembly=Oasis_Pipelines.Operations"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type dataTables:ConcatDataTablesOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <UniformGrid Columns="5" VerticalAlignment="Center">
                <material:PackIcon
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    Kind="Table" />
                <material:PackIcon
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Kind="ArrowRight" />
                <material:PackIcon
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    Kind="TableMergeCells" />
                <material:PackIcon
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    Kind="ArrowRight" />
                <material:PackIcon
                    Grid.Column="4"
                    HorizontalAlignment="Center"
                    Kind="Table" />
            </UniformGrid>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dataTables:ConcatDataTablesOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <material:Card>
                <UniformGrid Margin="5" Rows="2">
                    <ComboBox
                        ItemsSource="{Binding LeftColumns}"
                        MinHeight="24"
                        SelectedItem="{Binding SelectedLeftColumn}"
                        material:HintAssist.Hint="Left Join Column" />
                    <ComboBox
                        ItemsSource="{Binding RightColumns}"
                        MinHeight="24"
                        SelectedItem="{Binding SelectedRightColumn}"
                        material:HintAssist.Hint="Right Join Column" />
                </UniformGrid>
            </material:Card>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>