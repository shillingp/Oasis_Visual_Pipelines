<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Oasis_Pipelines.Controls.Wpf;assembly=Oasis_Pipelines.Controls.Wpf"
    xmlns:operations="clr-namespace:Oasis_Pipelines.Operations.Operations;assembly=Oasis_Pipelines.Operations">
    <DataTemplate DataType="{x:Type operations:DefaultBlockOperation}">
        <Button
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Command="{Binding ChooseBlockOperationTypeCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=controls:BlockControl}}"
            Content="Choose Block"
            Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
    </DataTemplate>
</ResourceDictionary>