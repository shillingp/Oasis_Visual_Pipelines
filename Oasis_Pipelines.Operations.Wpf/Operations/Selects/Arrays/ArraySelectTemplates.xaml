<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:arrays="clr-namespace:Oasis_Pipelines.Operations.Operations.Selects.Arrays;assembly=Oasis_Pipelines.Operations"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:wpf="clr-namespace:Oasis_Pipelines.Shared.Wpf;assembly=Oasis_Pipelines.Shared.Wpf">
    <DataTemplate DataType="{x:Type arrays:TakeArrayElementsOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <material:Card Margin="5">
                <wpf:NumericUpDownControl Minimum="0" NumberValue="{Binding ElementCount, Mode=TwoWay}" />
            </material:Card>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>