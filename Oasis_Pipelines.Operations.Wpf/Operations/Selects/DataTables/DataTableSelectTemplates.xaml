<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:Oasis_Pipelines.Controls;assembly=Oasis_Pipelines.Controls"
    xmlns:converters="clr-namespace:Oasis_Pipelines.Operations.Wpf.Converters"
    xmlns:local="clr-namespace:Oasis_Pipelines.Operations.Operations.Selects.DataTables;assembly=Oasis_Pipelines.Operations"
    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:wpf="clr-namespace:Oasis_Pipelines.Shared.Wpf;assembly=Oasis_Pipelines.Shared.Wpf"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type local:DistinctDataOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <UniformGrid Columns="5" VerticalAlignment="Center">
                <material:PackIcon HorizontalAlignment="Center" Kind="Numeric" />
                <material:PackIcon HorizontalAlignment="Center" Kind="ArrowRight" />
                <material:PackIcon HorizontalAlignment="Center" Kind="Filter" />
                <material:PackIcon HorizontalAlignment="Center" Kind="ArrowRight" />
                <material:PackIcon HorizontalAlignment="Center" Kind="Numeric" />
            </UniformGrid>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:FilterDataTableOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <material:Card Margin="5">
                <StackPanel>
                    <DockPanel>
                        <Button
                            Command="{Binding EditFiltersCommand}"
                            Content="{material:PackIcon Kind=Edit}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignToolButton}" />
                        <TextBlock
                            DockPanel.Dock="Left"
                            Margin="5,2"
                            Text="{Binding SelectedFilters.Count, StringFormat='{}{0} Active Filters'}"
                            VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid Columns="3" Margin="0,5">
                        <TextBlock HorizontalAlignment="Right" Text="All" />
                        <ToggleButton IsChecked="{Binding FilterAny}" />
                        <TextBlock HorizontalAlignment="Left" Text="Any" />
                    </UniformGrid>
                </StackPanel>
            </material:Card>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:RemoveBlanksOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <UniformGrid Columns="5" VerticalAlignment="Center">
                <material:PackIcon HorizontalAlignment="Center" Kind="Numeric" />
                <material:PackIcon HorizontalAlignment="Center" Kind="ArrowRight" />
                <material:PackIcon HorizontalAlignment="Center" Kind="PlaylistRemove" />
                <material:PackIcon HorizontalAlignment="Center" Kind="ArrowRight" />
                <material:PackIcon HorizontalAlignment="Center" Kind="Numeric" />
            </UniformGrid>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:SelectColumnOperation}">
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <material:Card Margin="5">
                <wpf:MultiSelectControl
                    ItemsSource="{Binding ValidColumns, Mode=TwoWay}"
                    MaxHeight="100"
                    SelectedItems="{Binding SelectedColumns, Mode=TwoWay}" />
            </material:Card>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:SortDataTableOperation}">
        <DataTemplate.Resources>
            <converters:IsEqualConverter x:Key="IsEqualConverter" />
        </DataTemplate.Resources>
        <DockPanel>
            <TextBlock
                DockPanel.Dock="Top"
                Text="{Binding OperationTitle}"
                TextWrapping="Wrap" />

            <material:Card Margin="5">
                <StackPanel Margin="5,2">
                    <ComboBox
                        Grid.ColumnSpan="2"
                        Grid.Row="0"
                        ItemsSource="{Binding ValidColumns}"
                        SelectedItem="{Binding ColumnName}" />

                    <UniformGrid Columns="2">
                        <RadioButton
                            Content="{material:PackIcon Kind=SortAscending}"
                            IsChecked="{Binding SortDirection, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static local:SortDirection.Ascending}}"
                            Style="{StaticResource MaterialDesignChoiceChipSecondaryOutlineRadioButton}" />
                        <RadioButton
                            Content="{material:PackIcon Kind=SortDescending}"
                            IsChecked="{Binding SortDirection, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static local:SortDirection.Descending}}"
                            Style="{StaticResource MaterialDesignChoiceChipSecondaryOutlineRadioButton}" />
                    </UniformGrid>
                </StackPanel>
            </material:Card>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>