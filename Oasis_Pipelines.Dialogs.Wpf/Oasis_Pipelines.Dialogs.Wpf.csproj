<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Oasis_Pipelines.Dialogs.Wpf</RootNamespace>
        <AssemblyName>Oasis_Pipelines.Dialogs.Wpf</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Oasis_Pipelines.Controls.Wpf\Oasis_Pipelines.Controls.Wpf.csproj" />
      <ProjectReference Include="..\Oasis_Pipelines.Operations\Oasis_Pipelines.Operations.csproj" />
      <ProjectReference Include="..\Oasis_Pipelines.Shared\Oasis_Pipelines.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="**\*ViewModel.cs">
            <DependentUpon>$([System.String]::Copy('%(Filename)').Replace('ViewModel', '.xaml'))</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

</Project>
