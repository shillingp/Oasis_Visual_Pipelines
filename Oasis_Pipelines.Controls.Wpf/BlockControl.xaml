<UserControl
    x:Class="Oasis_Pipelines.Controls.Wpf.BlockControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Oasis_Pipelines.Controls.Wpf.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Oasis_Pipelines.Controls.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="200"
    MinHeight="80"
    MaxHeight="120"
    d:DataContext="{d:DesignInstance local:BlockControlViewModel}"
    d:DesignHeight="120"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:AppendExtraConnectionConverter x:Key="AppendExtraConnectionConverter" />

        <Style x:Key="NonEditableTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                            Text="{TemplateBinding Text}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" />
            <ColumnDefinition />
            <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card
            x:Name="TopLevelCard"
            Grid.ColumnSpan="3"
            Margin="15,0"
            PreviewMouseDown="TopLevelCard_PreviewMouseDown"
            SnapsToDevicePixels="True">
            <materialDesign:Card.Style>
                <Style TargetType="materialDesign:Card">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="5"
                                        Direction="270"
                                        Opacity=".42"
                                        RenderingBias="Performance"
                                        ShadowDepth="1"
                                        Color="Red" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:Card.Style>
            <DockPanel>
                <Border
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="LightGray"
                    BorderThickness="0,0,0,1"
                    CornerRadius="3,3,0,0"
                    DockPanel.Dock="Top">
                    <DockPanel>
                        <Grid DockPanel.Dock="Left">
                            <materialDesign:PackIcon
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Kind="Drag" />
                            <Thumb
                                Grid.RowSpan="2"
                                Cursor="SizeAll"
                                DragDelta="Thumb_OnDragDelta" />
                        </Grid>

                        <Button
                            VerticalAlignment="Center"
                            Command="{Binding RemoveBlockCommand}"
                            Content="{materialDesign:PackIcon Kind=Close}"
                            DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignToolButton}" />

                        <local:EditableTextBox
                            Height="24"
                            VerticalAlignment="Center"
                            materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                            DockPanel.Dock="Right"
                            EditingStyle="{StaticResource MaterialDesignTextBoxBase}"
                            ReadOnlyStyle="{StaticResource NonEditableTextBox}"
                            Text="{Binding Block.BlockTitle, FallbackValue=''}" />
                    </DockPanel>
                </Border>

                <Button
                    Height="12"
                    Command="{Binding ToggleBlockHeightCommand}"
                    Cursor="Hand"
                    DockPanel.Dock="Bottom"
                    Style="{x:Null}"
                    Visibility="Collapsed">
                    <!-- <Button.Visibility> -->
                    <!--     <MultiBinding Converter="{StaticResource HeightExpanderButtonVisibilityConverter}"> -->
                    <!--         <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=local:BlockControl}" /> -->
                    <!--         <Binding Path="MaxHeight" RelativeSource="{RelativeSource AncestorType=local:BlockControl}" /> -->
                    <!--         <Binding Path="IsExpanded" RelativeSource="{RelativeSource AncestorType=local:BlockControl}" /> -->
                    <!--     </MultiBinding> -->
                    <!-- </Button.Visibility> -->
                    <Button.Template>
                        <ControlTemplate>
                            <Border
                                Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="LightGray"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,3,3">
                                <Grid HorizontalAlignment="Center">
                                    <materialDesign:PackIcon VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="TriangleSmallDown" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Kind" Value="TriangleSmallUp" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ContentPresenter
                    Margin="10,0"
                    Content="{Binding Block.Operation, FallbackValue={x:Null}}"
                    DockPanel.Dock="Bottom" />
            </DockPanel>
        </materialDesign:Card>


        <ItemsControl
            x:Name="RightConnectorsControl"
            Grid.Column="2"
            VerticalAlignment="Center"
            d:ItemsSource="{d:SampleData ItemCount=2}">
            <ItemsControl.ItemsSource>
                <MultiBinding Converter="{StaticResource AppendExtraConnectionConverter}">
                    <Binding FallbackValue="{x:Null}" Path="Block.DownstreamConnections" />
                    <Binding FallbackValue="0" Path="Block.DownstreamConnections.Count" />
                </MultiBinding>
            </ItemsControl.ItemsSource>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:ConnectorNode
                        Height="20"
                        Connection="{Binding}"
                        ConnectionSide="Right"
                        DragController="{Binding ConnectorDragController}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
