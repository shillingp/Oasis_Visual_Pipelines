<UserControl
    x:Class="Oasis_Pipelines.Controls.Wpf.ConnectorNode"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Oasis_Pipelines.Controls.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <materialDesign:Card
        Width="{Binding Source={x:Static local:ConnectorNode.ConnectorNodeSize}}"
        Height="{Binding Source={x:Static local:ConnectorNode.ConnectorNodeSize}}"
        BorderBrush="Black"
        BorderThickness="1">
        <materialDesign:Card.Style>
            <Style TargetType="materialDesign:Card">
                <Setter Property="Cursor" Value="Cross" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Connection, RelativeSource={RelativeSource AncestorType=local:ConnectorNode}}" Value="{x:Null}">
                        <Setter Property="Cursor" Value="Hand" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </materialDesign:Card.Style>
        <Grid>
            <Ellipse
                x:Name="HasConnectionsBlob"
                Fill="OrangeRed"
                Stroke="Transparent"
                StrokeThickness="4">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Connection, RelativeSource={RelativeSource AncestorType=local:ConnectorNode}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <Thumb
                DragCompleted="ConnectorThumb_DragCompleted"
                DragDelta="ConnectorThumb_DragDelta"
                DragStarted="ConnectorThumb_DragStarted" />
        </Grid>
    </materialDesign:Card>
</UserControl>
