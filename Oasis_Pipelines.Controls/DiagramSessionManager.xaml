<UserControl
    x:Class="Oasis_Pipelines.Controls.DiagramSessionManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Oasis_Pipelines.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sessionManagement="clr-namespace:Oasis_Pipelines.Services.SessionManagement;assembly=Oasis_Pipelines"
    d:DataContext="{d:DesignInstance controls:DiagramSessionManager}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <TabControl
        DataContext="{Binding RelativeSource={RelativeSource AncestorType=controls:DiagramSessionManager}}"
        ItemsSource="{Binding SessionManager.ActiveSessions}"
        SelectedItem="{Binding SessionManager.CurrentSession}">
        <TabControl.ItemTemplate>
            <DataTemplate DataType="{x:Type sessionManagement:ISessionContext}">
                <TextBlock Text="{Binding SessionTitle}" />
            </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
            <DataTemplate DataType="{x:Type sessionManagement:ISessionContext}">
                <controls:DiagramSession SessionContext="{Binding}" />
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>
