<UserControl
    d:DataContext="{d:DesignInstance controls:DiagramSessionViewModel}"
    d:Height="450"
    d:Width="800"
    mc:Ignorable="d"
    x:Class="Oasis_Pipelines.Controls.DiagramSession"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:Oasis_Pipelines.Controls"
    xmlns:converters="clr-namespace:Oasis_Pipelines.Controls.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interfaces="clr-namespace:Oasis_Pipelines.Interfaces;assembly=Oasis_Pipelines"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Oasis_Pipelines.Model;assembly=Oasis_Pipelines"
    xmlns:templateSelectors="clr-namespace:Oasis_Pipelines.Controls.Classes.TemplateSelectors"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <converters:ConcatenatePipelineObjectsConverter x:Key="ConcatenateConverter" />

        <DataTemplate DataType="{x:Type models:Block}">
            <controls:BlockControl Block="{Binding}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:Connection}">
            <Thumb
                Background="Blue"
                Height="5"
                Width="5" />
        </DataTemplate>

        <!--  <templateSelectors:PipelineObjectTemplateSelector  -->
        <!--  BlockTemplate="{StaticResource BlockDataTemplate}"  -->
        <!--  ConnectionTemplate="{StaticResource ConnectionDataTemplate}"  -->
        <!--  x:Key="PipelineObjectTemplateSelector" />  -->
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <ItemsControl
            Background="Gray"
            Height="500"
            Width="500">
            <!--  ItemTemplateSelector="{StaticResource PipelineObjectTemplateSelector}"  -->
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseLeftButtonDown">
                    <b:InvokeCommandAction Command="{Binding AddBlockCommand}" PassEventArgsToCommand="True" />
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <ItemsControl.ItemsSource>
                <MultiBinding Converter="{StaticResource ConcatenateConverter}">
                    <Binding FallbackValue="{x:Null}" Path="SessionContext.BlockManager.AllBlocks" />
                    <Binding FallbackValue="{x:Null}" Path="SessionContext.ConnectionManager.AllConnections" />
                    <Binding FallbackValue="0" Path="SessionContext.BlockManager.AllBlocks.Count" />
                    <Binding FallbackValue="0" Path="SessionContext.ConnectionManager.AllConnections.Count" />
                </MultiBinding>
            </ItemsControl.ItemsSource>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas ClipToBounds="True" x:Name="BlockDiagramCanvas" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ContentPresenter}" d:DataContext="{d:DesignInstance {x:Type interfaces:IPipelineObject}}">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </Grid>
</UserControl>