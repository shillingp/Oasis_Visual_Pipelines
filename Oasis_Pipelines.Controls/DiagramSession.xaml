<UserControl
    d:DataContext="{d:DesignInstance controls:DiagramSession}"
    d:Height="450"
    d:Width="800"
    mc:Ignorable="d"
    x:Class="Oasis_Pipelines.Controls.DiagramSession"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:Oasis_Pipelines.Controls"
    xmlns:converters="clr-namespace:Oasis_Pipelines.Controls.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interfaces="clr-namespace:Oasis_Pipelines.Interfaces;assembly=Oasis_Pipelines"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:templateSelectors="clr-namespace:Oasis_Pipelines.Controls.Classes.TemplateSelectors"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <converters:ConcatenatePipelineObjectsConverter x:Key="ConcatenateConverter" />

        <DataTemplate x:Key="Thing1">
            <Thumb
                Background="Red"
                DragDelta="Thumb_OnDragDelta"
                Height="100"
                Width="100" />
        </DataTemplate>

        <DataTemplate x:Key="Thing2">
            <Thumb
                Background="Blue"
                DragDelta="Thumb_OnDragDelta"
                Height="50"
                Width="50" />
        </DataTemplate>

        <templateSelectors:PipelineObjectTemplateSelector
            BlockTemplate="{StaticResource Thing1}"
            ConnectionTemplate="{StaticResource Thing2}"
            x:Key="PipelineObjectTemplateSelector" />
    </UserControl.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=controls:DiagramSession}}">
        <ItemsControl DataContext="{Binding SessionContext}" ItemTemplateSelector="{StaticResource PipelineObjectTemplateSelector}">
            <ItemsControl.ItemsSource>
                <MultiBinding Converter="{StaticResource ConcatenateConverter}">
                    <Binding Path="BlockManager.AllBlocks" />
                    <Binding Path="ConnectionManager.AllConnections" />
                </MultiBinding>
            </ItemsControl.ItemsSource>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas ClipToBounds="True" x:Name="BlockDiagramCanvas" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ContentPresenter}" d:DataContext="{d:DesignInstance {x:Type interfaces:IPipelineObject}}">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>
    </Grid>
</UserControl>