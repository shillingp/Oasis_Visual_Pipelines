<UserControl
    d:Background="White"
    d:DesignHeight="80"
    d:DesignWidth="180"
    mc:Ignorable="d"
    x:Class="Oasis_Pipelines.Controls.MultiSelectControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:Oasis_Pipelines.Controls"
    xmlns:converters1="clr-namespace:Oasis_Pipelines.Controls.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <converters1:CollectionContainsConverter x:Key="CollectionContainsConverter" />
    </UserControl.Resources>
    <Grid MinHeight="30">
        <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource MaterialDesignCharacterCounterTextBlock}"
            Text="No Table Input"
            VerticalAlignment="Center" />
        <ListView
            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=controls:MultiSelectControl}, Path=ItemsSource}"
            MaxHeight="100"
            ScrollViewer.CanContentScroll="False"
            SelectionMode="Extended"
            d:ItemsSource="{d:SampleData ItemCount=5}"
            x:Name="ItemSelectionListView">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource MaterialDesignListBoxItem}" TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="{StaticResource MaterialDesignBackground}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <CheckBox
                        Checked="CheckBox_Checked"
                        Content="{Binding}"
                        Unchecked="CheckBox_Unchecked"
                        VerticalAlignment="Center">
                        <CheckBox.IsChecked>
                            <MultiBinding Converter="{StaticResource CollectionContainsConverter}" Mode="OneWay">
                                <Binding Path="SelectedItems" RelativeSource="{RelativeSource AncestorType=controls:MultiSelectControl}" />
                                <Binding Path="." />
                            </MultiBinding>
                        </CheckBox.IsChecked>
                    </CheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
